{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.sentineltwin.user",
  "productName": "SentinelTwin-User",
  "copyright": "Copyright © 2026 SentinelTwin Team",
  "directories": {
    "output": "dist_package"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}.${ext}"
  },
  "portable": {
    "artifactName": "SentinelTwin-User.exe"
  },
  "asar": true
}
