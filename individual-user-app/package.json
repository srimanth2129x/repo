{
  "name": "sentineltwin-user",
  "version": "1.0.0",
  "description": "SentinelTwin Individual User Desktop Application",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "SentinelTwin Team",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -s first \"vite\" \"wait-on tcp:5174 && electron . --dev\"",
    "build": "vite build",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --win --dir",
    "build:all": "vite build && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.0",
    "wait-on": "^8.0.2"
  }
}